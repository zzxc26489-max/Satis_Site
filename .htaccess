# Заголовки безопасности для Apache.
# Файл кладётся в корень сайта и работает сам, настраивать ничего не нужно.

<IfModule mod_headers.c>
    # Сайт нельзя встроить в чужой фрейм — защита от подделки кликов,
    # когда поверх невидимого фрейма рисуют свои кнопки.
    Header always set X-Frame-Options "DENY"

    # Браузер не пытается угадывать тип файла: загруженная картинка
    # не может «превратиться» в скрипт.
    Header always set X-Content-Type-Options "nosniff"

    # На чужие сайты не утекает полный адрес страницы, только домен.
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # Странице не нужны камера, микрофон и геолокация — запрещаем.
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"

    # Та же политика содержимого, что и в мета-теге, плюс frame-ancestors,
    # который работает только отсюда.
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; form-action 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; upgrade-insecure-requests"

    # Год держать сайт только на HTTPS. Включать ПОСЛЕ того, как
    # сертификат точно работает, иначе браузер запомнит недоступный адрес.
    # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

# Принудительный HTTPS
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTPS} !=on
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# Не показывать список файлов, если в папке нет index.html
Options -Indexes

# Закрыть служебные файлы. photos.json тоже закрыт: он нужен только
# при пересборке фотографий, сайту во время работы не требуется.
<FilesMatch "^\.|\.(json|md|py|sh|bak|log|yml|yaml)$">
    Require all denied
</FilesMatch>
